---
import { skills } from '../data/skills.js';
---
<section id="habilidades" class="max-w-3xl mx-auto px-6 py-12">
  <h2 class="text-2xl sm:text-3xl font-display mb-8 text-center">Tecnologías</h2>
  <ul class="flex flex-wrap justify-center gap-6">
    {skills.map((skill) => (
      <li class="flex flex-col items-center gap-2 w-16">
        <img
          src={`https://cdn.simpleicons.org/${skill.icon}/9a90c0`}
          alt={skill.name}
          width="32"
          height="32"
          loading="lazy"
          class="opacity-80 hover:opacity-100 transition-opacity"
        />
        <span class="text-[10px] text-muted text-center">{skill.name}</span>
      </li>
    ))}
  </ul>
</section>
