---
import { projects } from '../data/projects.js';
---
<section id="proyectos" class="max-w-4xl mx-auto px-6 py-24">
  <h2 class="text-2xl sm:text-3xl font-semibold mb-10 text-center">Proyectos</h2>
  <div class="grid sm:grid-cols-2 gap-6">
    {projects.map((project) => (
      <article class="border border-border rounded-lg p-6 hover:border-accent transition-colors">
        <h3 class="text-lg font-medium mb-2">{project.name}</h3>
        <p class="text-sm text-muted mb-4 leading-relaxed">{project.description}</p>
        <ul class="flex flex-wrap gap-2 mb-4">
          {project.tags.map((tag) => (
            <li class="text-xs text-accentLight border border-accent/40 rounded px-2 py-0.5">
              {tag}
            </li>
          ))}
        </ul>
        <div class="flex gap-4 text-sm">
          {project.url && (
            <a href={project.url} class="text-accentLight hover:underline" target="_blank" rel="noopener">
              Ver sitio
            </a>
          )}
          {project.repo && (
            <a href={project.repo} class="text-muted hover:text-white hover:underline" target="_blank" rel="noopener">
              Código
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
