# Puerto y dirección donde escucha la app (0.0.0.0 = visible en tu red local)
PORT=3000
HOST=0.0.0.0

# Base de datos en tu servidor (crea la base antes: CREATE DATABASE copcash;)
DATABASE_URL=postgresql://USUARIO:CLAVE@192.168.1.46:5432/copcash

# Secreto para firmar las sesiones: genera uno con
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Publicación en internet (skaylabs.site/copcash) ──
# Ruta bajo la que se publica. En la red local la app sigue respondiendo también en la raíz.
BASE_PATH=/copcash
# Secreto compartido con la función de Cloudflare Pages (COPCASH_SECRETO). Genéralo igual que JWT_SECRET.
# Con esto definido, el servidor rechaza peticiones que lleguen por Cloudflare sin el secreto.
ORIGEN_SECRETO=
# 0 para cerrar el registro de cuentas nuevas
PERMITIR_REGISTRO=1
