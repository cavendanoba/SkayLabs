# DATABASE
DATABASE_URL="postgresql://optix_user:optix_password_dev@localhost:5432/optix_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars!"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-production-min-32!"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ENVIRONMENT
NODE_ENV="development"
PORT=3001
API_VERSION="v1"

# CORS
FRONTEND_URL="http://localhost:5173"

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# REDIS (future use)
REDIS_URL="redis://localhost:6379"

# UPLOADS
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES="pdf,jpg,jpeg,png,doc,docx"

# EMAIL (SendGrid - future)
SENDGRID_API_KEY=""

# SMS (Twilio - future)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE=""

# STORAGE (S3/MinIO - future)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
